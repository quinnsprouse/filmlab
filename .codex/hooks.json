{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/pre-tool-guard.mjs\"",
            "statusMessage": "Checking the tool call against project guards",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/stop-check.mjs\"",
            "statusMessage": "Running clippy on the changed crates before the turn ends",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
