{
  "name": "rodeo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build --logLevel error",
    "preview": "vp preview",
    "start": "node .output/server/index.mjs",
    "prepare": "node scripts/setup.mjs",
    "setup": "node scripts/setup.mjs",
    "setup:skills": "vp dlx skills@1.5.15 experimental_install",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:e2e": "tsc -b && vp build --mode e2e --logLevel error && playwright test",
    "test:e2e:ui": "npm run test:e2e -- --ui",
    "test:e2e:headed": "npm run test:e2e -- --headed",
    "test:e2e:install": "playwright install chromium",
    "test:template": "node scripts/test-template.mjs",
    "typecheck": "tsc -b",
    "knip": "knip",
    "check": "node scripts/run-verification.mjs verify:fast",
    "check:push": "node scripts/run-verification.mjs verify:push",
    "check:ci": "node scripts/run-verification.mjs verify:ci",
    "doctor": "react-doctor --verbose",
    "build:engine": "node scripts/build-engine.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/open-runde": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-start": "^1.168.61",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dialkit": "^2.0.2",
    "motion": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^8.0.6",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@shadcn/lint": "^0.2.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.34.0",
    "nitro": "^3.0.260903-beta",
    "react-doctor": "0.9.14",
    "typescript": "^7.0.2",
    "vite-plus": "1.0.0-rc.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
    "vitest": "5.0.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.12.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24.11.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^24.11.0"
  },
  "packageManager": "npm@11.12.0"
}
